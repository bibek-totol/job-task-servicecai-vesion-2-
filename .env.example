# Environment variables for site-wide password protection
# Copy to .env.local for local development, and configure in Vercel Project Settings for production.

# The password required to unlock the site
SITE_PASSWORD="YourStrongPassword2026!"

# Secret used to sign HMAC-SHA256 session cookies (min 32 chars)
# Generate a fresh key using: openssl rand -base64 32
SITE_PASSWORD_SECRET="change-this-to-a-secure-random-32-character-secret-key-in-production"
